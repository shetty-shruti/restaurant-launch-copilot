# --- LLM provider: azure_openai | bedrock | openai | anthropic ---
LLM_PROVIDER=azure_openai
LLM_MODEL_LARGE=
LLM_MODEL_SMALL=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
AWS_REGION=us-east-1
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Embeddings ---
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384

# --- Database (matches infra/docker-compose.yml) ---
DATABASE_URL=postgresql+psycopg://copilot:copilot@localhost:5432/copilot

# --- Langfuse tracing ---
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# --- Cities (jurisdiction ids, comma-separated; federal rules are always loaded) ---
CITIES=us-ny-nyc
# Optional NYC Open Data app token (raises the anonymous rate limit)
SOCRATA_APP_TOKEN=

# --- Kafka (weeks 5 to 6) ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_NEW=inspections.new
KAFKA_TOPIC_INDEXED=inspections.indexed
KAFKA_TOPIC_DLQ=inspections.dlq

# --- Agent limits (week 4) ---
AGENT_MAX_STEPS=8
AGENT_TOKEN_BUDGET=20000
